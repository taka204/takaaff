# ---------------------------------------------------------------------------
# TakaAff
# Copy sang .env rồi điền. KHÔNG commit file .env.
# ---------------------------------------------------------------------------

# --- Bốn tham số CHƯA XÁC MINH (xem mục 01 tài liệu chiến lược) -------------
# Tự tra trong dashboard affiliate rồi sửa lại. Các nguồn công khai mâu thuẫn
# nhau (30.000 / 50.000 / 70.000), nên giá trị dưới đây chỉ là mặc định thận
# trọng: đặt thấp thì engine tự động tránh săn đơn giá trị cao, sai theo hướng
# an toàn.
TAKAAFF_PER_ORDER_CAP_VND=30000

# Vùng giá engine ưu tiên. Ngoài vùng này điểm bị phạt, không bị loại.
TAKAAFF_MIN_PRICE_VND=50000
TAKAAFF_MAX_PRICE_VND=1000000

# --- Database ---------------------------------------------------------------
TAKAAFF_DB_PATH=data/takaaff.db

# --- Shopee Affiliate Open API (M3 - chưa cần cho M1/M2) --------------------
# Chưa được cấp quyền thì để trống; `npm run shopee:ping` sẽ báo rõ trạng thái.
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_API_ENDPOINT=https://open-api.affiliate.shopee.vn/graphql

# --- Telegram ---------------------------------------------------------------
# Lấy token từ @BotFather. chat_id của kênh dạng -100xxxxxxxxxx.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
