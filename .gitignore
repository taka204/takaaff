node_modules/
.env

# Nội dung agent skill tải về từ skills-lock.json — quan hệ giống node_modules
# với package-lock.json: lockfile được commit, nội dung thì không.
# Hai thư mục này là bản sao giống hệt nhau của cùng một bộ skill.
.agents/skills/
.claude/skills/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# data/exports KHÔNG bị ignore: workflow kích hoạt khi push vào đó, đó là cách
# đưa CSV xuất tay lên cloud khi chưa có quyền Open API. Nội dung là dữ liệu
# niêm yết công khai của Shopee, nhưng nếu repo để public thì chúng cũng public.
*.log

.vercel
.env*

# api/ chứa bundle sinh ra lúc build, không phải mã nguồn. Nguồn ở src/api/.
# Vercel biên dịch từng file .ts riêng lẻ chứ không bundle, nên nó để nguyên
# chuỗi import './_auth.ts' rồi không resolve được lúc chạy. Tự bundle là cách
# giữ được quy ước .ts của repo mà vẫn ra thứ Vercel chạy được.
# Neo vào thư mục gốc: pattern trần `api/` khớp ở mọi cấp và sẽ nuốt luôn
# src/api/, nơi chứa mã nguồn.
/api/
