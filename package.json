{
  "name": "takaaff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shopee affiliate deal engine - chấm điểm sản phẩm theo giá trị kỳ vọng mỗi click",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:init": "node --disable-warning=ExperimentalWarning src/cli.ts db:init",
    "ingest": "node --disable-warning=ExperimentalWarning src/cli.ts ingest",
    "rank": "node --disable-warning=ExperimentalWarning src/cli.ts rank",
    "link": "node --disable-warning=ExperimentalWarning src/cli.ts link",
    "publish": "node --disable-warning=ExperimentalWarning src/cli.ts publish",
    "sync": "node --disable-warning=ExperimentalWarning src/cli.ts sync",
    "conversions:import": "node --disable-warning=ExperimentalWarning src/cli.ts conversions:import",
    "clicks:pending": "node --disable-warning=ExperimentalWarning src/cli.ts clicks:pending",
    "clicks:set": "node --disable-warning=ExperimentalWarning src/cli.ts clicks:set",
    "clicks:import": "node --disable-warning=ExperimentalWarning src/cli.ts clicks:import",
    "epc": "node --disable-warning=ExperimentalWarning src/cli.ts epc",
    "shopee:ping": "node --disable-warning=ExperimentalWarning src/cli.ts shopee:ping",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
